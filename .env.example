# --- Persistence -----------------------------------------------------------
# Railway PostgreSQL connection string. When unset, the app runs on a
# fixture-seeded in-memory store (local development default).
DATABASE_URL=

# --- Admin auth (Better Auth) ----------------------------------------------
# Production MUST set all of these. Development falls back to
# admin@wc2026.local / WC2026Admin! with a generated dev secret.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
BETTER_AUTH_SECRET=
# Public URL of the deployment, e.g. https://wc2026.up.railway.app
BETTER_AUTH_URL=

# --- Tournament ------------------------------------------------------------
# First-match kickoff; submissions and edit links lock at this instant.
TOURNAMENT_LOCK_AT=2026-06-11T19:00:00Z
ALLOW_PUBLIC_SUBMISSIONS=true

# --- Imports ----------------------------------------------------------------
# Where raw import artifacts are cached before parsing (gitignored).
IMPORT_CACHE_DIR=.data-cache
